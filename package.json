{
  "name": "ciphergate-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CipherGate: Zero-Knowledge Age & Eligibility Gate on Midnight Blockchain using Compact smart contracts.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:contract": "npm run --prefix contract build",
    "compact:contract": "npm run --prefix contract compact",
    "build:frontend": "npm run --prefix frontend build",
    "dev:frontend": "npm run --prefix frontend dev",
    "deploy:local": "ts-node scripts/deploy-local.ts",
    "build": "npm run build:contract && npm run build:frontend"
  },
  "workspaces": [
    "contract",
    "frontend"
  ],
  "devDependencies": {
    "@types/node": "^20.12.7",
    "happy-dom": "^14.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "zk-proof",
    "privacy",
    "age-gate",
    "eligibility",
    "dapp"
  ],
  "author": "Rohan809raj",
  "license": "MIT"
}
