{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@contract/*": ["../contract/*"],
      "@contract": ["../contract/index.ts"]
    }
  },
  "include": ["src", "../contract"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "tests"]
}
